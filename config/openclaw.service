# Openclaw Gateway System Service
# Install to: /etc/systemd/system/openclaw.service
#
# Dependencies:
#   - home-fx-.openclaw-runtime.mount (tmpfs for secrets)
#   - /usr/local/bin/openclaw-start.sh (decrypt and start wrapper)
#
# Architecture:
#   `openclaw gateway run` spawns a detached openclaw-gateway child process
#   and the parent exits — this is normal OpenClaw behavior on Linux with
#   systemd detected. Type=oneshot + RemainAfterExit tells systemd to expect
#   the parent to exit and keeps the service marked as "active".
#
#   ExecStartPre kills orphaned gateway processes from previous runs.
#   ExecStop/ExecStopPost kills the detached child(ren) on service stop.
#   The healthcheck cron (every 15 min) monitors the gateway child process
#   and can trigger auto-repair if it crashes.
#
# Usage:
#   sudo systemctl enable openclaw
#   sudo systemctl start openclaw
#   sudo journalctl -u openclaw -f

[Unit]
Description=Openclaw Gateway
After=network.target home-fx-.openclaw-runtime.mount
Requires=home-fx-.openclaw-runtime.mount

[Service]
Type=oneshot
RemainAfterExit=yes
# Phase 1 (root): decrypt secrets to tmpfs
ExecStartPre=+/usr/local/bin/openclaw-start.sh
# Phase 2 (root): kill any orphaned gateway processes from previous runs
ExecStartPre=+/bin/bash -c 'pgrep -x "openclaw-gatewa" | xargs -r kill -9 || true; sleep 1'
# Phase 3 (fx): start gateway (spawns detached child, parent exits)
ExecStart=/home/fx/.local/share/npm-global/bin/openclaw gateway run --force
ExecStop=+/bin/bash -c 'pgrep -x "openclaw-gatewa" | xargs -r kill || true'
ExecStopPost=+/bin/bash -c 'sleep 1; pgrep -x "openclaw-gatewa" | xargs -r kill -9 || true'
User=fx
Group=fx
WorkingDirectory=/home/fx/clawd
Environment="HOME=/home/fx"
Environment="PATH=/home/fx/.nix-profile/bin:/home/fx/.local/share/npm-global/bin:/home/fx/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
Environment="OPENCLAW_GATEWAY_TOKEN=local-gateway-token"
# Parent spawns detached child and exits with code 1 (port conflict with its
# own child). SuccessExitStatus=1 tells systemd this is expected behavior.
SuccessExitStatus=1
TimeoutStartSec=60
TimeoutStopSec=15
# Security hardening
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/fx/.openclaw /home/fx/.secrets /home/fx/clawd /home/fx/.config/rclone /home/fx/openclaw-git
PrivateTmp=true
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
