# Openclaw Gateway System Service
# Install to: /etc/systemd/system/openclaw.service
#
# Dependencies:
#   - home-fx-.openclaw-runtime.mount (tmpfs for secrets)
#   - /usr/local/bin/openclaw-start.sh (decrypt and start wrapper)
#
# Architecture:
#   ExecStartPre (root): decrypts secrets to tmpfs.
#   ExecStart (fx): runs gateway in foreground with OPENCLAW_NO_RESPAWN=1
#   to prevent the default detached-fork behavior.
#
# IMPORTANT: The old user-level service (systemctl --user openclaw-gateway)
#   must be disabled. Two services on port 18789 causes restart loops.
#
# Usage:
#   sudo systemctl enable openclaw
#   sudo systemctl start openclaw
#   sudo journalctl -u openclaw -f

[Unit]
Description=Openclaw Gateway
After=network.target home-fx-.openclaw-runtime.mount
Requires=home-fx-.openclaw-runtime.mount

[Service]
Type=simple
# Phase 1 (root): decrypt secrets to tmpfs
ExecStartPre=+/usr/local/bin/openclaw-start.sh
# Phase 2 (fx): start gateway in foreground
ExecStart=/home/fx/.local/share/npm-global/bin/openclaw gateway run
User=fx
Group=fx
WorkingDirectory=/home/fx/clawd
Environment="HOME=/home/fx"
Environment="PATH=/home/fx/.nix-profile/bin:/home/fx/.local/share/npm-global/bin:/home/fx/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
Environment="OPENCLAW_GATEWAY_TOKEN=local-gateway-token"
# Prevent gateway from forking a detached child; run in true foreground
Environment="OPENCLAW_NO_RESPAWN=1"
Restart=on-failure
RestartSec=10
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15
# Security hardening
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/fx/.openclaw /home/fx/.secrets /home/fx/clawd /home/fx/.config/rclone /home/fx/openclaw-git
PrivateTmp=true
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
